# CUDA/PyTorch 3DGS training environment.
# The repository and datasets are mounted at runtime; they are not copied into
# the image. Build with CUDA_BASE_IMAGE set to the locally tagged CUDA image on
# the shared server, or leave the default for a portable Dockerfile.

ARG CUDA_BASE_IMAGE=nvidia/cuda:11.6.2-devel-ubuntu20.04
FROM ${CUDA_BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TORCH_CUDA_ARCH_LIST=8.6

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=2 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        bzip2 \
        build-essential \
        ca-certificates \
        git \
        libgl1 \
        libglib2.0-0 \
        ninja-build \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Python 3.7 is required by the repository's pinned environment.yml.
RUN wget -q \
        https://repo.anaconda.com/miniconda/Miniconda3-py37_4.12.0-Linux-x86_64.sh \
        -O /tmp/miniconda.sh \
    && echo "4dc4214839c60b2f5eb3efbdee1ef5d9b45e74f2c09fcae6c8934a13f36ffc3e  /tmp/miniconda.sh" \
        | sha256sum -c - \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm -f /tmp/miniconda.sh \
    && /opt/conda/bin/conda config --system --set always_yes yes \
    && /opt/conda/bin/conda config --system --set changeps1 no \
    && /opt/conda/bin/conda install --name base --channel conda-forge \
        --override-channels mamba=0.27.0 \
    && /opt/conda/bin/conda clean --all --yes

ENV PATH=/opt/conda/bin:$PATH

# Keep the build context limited to the environment file and CUDA submodules.
# The local paths in environment.yml are resolved from this working directory.
WORKDIR /opt/gs-build
COPY environment.yml ./environment.yml
COPY submodules ./submodules

RUN mamba env create --file environment.yml \
    && conda clean --all --yes \
    && rm -rf /root/.cache /opt/conda/pkgs

ENV CONDA_DEFAULT_ENV=gaussian_splatting \
    PATH=/opt/conda/envs/gaussian_splatting/bin:/opt/conda/bin:$PATH

# Fail the image build if the pinned Python/Torch environment or CUDA
# extensions were not installed correctly. This does not require a GPU during
# docker build; the CUDA runtime is checked when the container is run.
RUN python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)" \
    && python -c "import diff_gaussian_rasterization; import simple_knn._C; import fused_ssim; print('3DGS extensions: OK')"

WORKDIR /repo
CMD ["python", "--version"]
